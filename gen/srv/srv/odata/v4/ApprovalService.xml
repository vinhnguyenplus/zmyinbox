<?xml version="1.0" encoding="utf-8"?>
<edmx:Edmx Version="4.0" xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx">
  <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/Common.xml">
    <edmx:Include Alias="Common" Namespace="com.sap.vocabularies.Common.v1"/>
  </edmx:Reference>
  <edmx:Reference Uri="https://oasis-tcs.github.io/odata-vocabularies/vocabularies/Org.OData.Core.V1.xml">
    <edmx:Include Alias="Core" Namespace="Org.OData.Core.V1"/>
  </edmx:Reference>
  <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/UI.xml">
    <edmx:Include Alias="UI" Namespace="com.sap.vocabularies.UI.v1"/>
  </edmx:Reference>
  <edmx:DataServices>
    <Schema Namespace="ApprovalService" xmlns="http://docs.oasis-open.org/odata/ns/edm">
      <Annotation Term="Core.Links">
        <Collection>
          <Record>
            <PropertyValue Property="rel" String="author"/>
            <PropertyValue Property="href" String="https://cap.cloud.sap"/>
          </Record>
        </Collection>
      </Annotation>
      <EntityContainer Name="EntityContainer">
        <EntitySet Name="Employee" EntityType="ApprovalService.Employee"/>
        <EntitySet Name="LeaveRequest" EntityType="ApprovalService.LeaveRequest">
          <NavigationPropertyBinding Path="employee" Target="Employee"/>
        </EntitySet>
        <EntitySet Name="WorkflowTask" EntityType="ApprovalService.WorkflowTask">
          <NavigationPropertyBinding Path="employee" Target="Employee"/>
          <NavigationPropertyBinding Path="leaveRequest" Target="LeaveRequest"/>
        </EntitySet>
        <EntitySet Name="ApprovalHistory" EntityType="ApprovalService.ApprovalHistory">
          <NavigationPropertyBinding Path="workflowTask" Target="WorkflowTask"/>
          <NavigationPropertyBinding Path="leaveRequest" Target="LeaveRequest"/>
        </EntitySet>
        <ActionImport Name="approveTask" Action="ApprovalService.approveTask" EntitySet="WorkflowTask"/>
        <ActionImport Name="rejectTask" Action="ApprovalService.rejectTask" EntitySet="WorkflowTask"/>
      </EntityContainer>
      <EntityType Name="Employee">
        <Key>
          <PropertyRef Name="ID"/>
        </Key>
        <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
        <Property Name="employeeNumber" Type="Edm.String" MaxLength="20"/>
        <Property Name="fullName" Type="Edm.String" MaxLength="120" Nullable="false"/>
        <Property Name="position" Type="Edm.String" MaxLength="80"/>
        <Property Name="department" Type="Edm.String" MaxLength="80"/>
        <Property Name="email" Type="Edm.String" MaxLength="120"/>
        <Property Name="managerName" Type="Edm.String" MaxLength="120"/>
      </EntityType>
      <EntityType Name="LeaveRequest">
        <Key>
          <PropertyRef Name="ID"/>
        </Key>
        <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
        <Property Name="createdAt" Type="Edm.DateTimeOffset" Precision="7"/>
        <Property Name="createdBy" Type="Edm.String" MaxLength="255"/>
        <Property Name="modifiedAt" Type="Edm.DateTimeOffset" Precision="7"/>
        <Property Name="modifiedBy" Type="Edm.String" MaxLength="255"/>
        <NavigationProperty Name="employee" Type="ApprovalService.Employee" Nullable="false">
          <ReferentialConstraint Property="employee_ID" ReferencedProperty="ID"/>
        </NavigationProperty>
        <Property Name="employee_ID" Type="Edm.Guid" Nullable="false"/>
        <Property Name="type" Type="Edm.String" MaxLength="40" Nullable="false"/>
        <Property Name="startDate" Type="Edm.Date" Nullable="false"/>
        <Property Name="endDate" Type="Edm.Date" Nullable="false"/>
        <Property Name="days" Type="Edm.Int32" Nullable="false"/>
        <Property Name="reason" Type="Edm.String" MaxLength="500"/>
        <Property Name="status" Type="Edm.String" MaxLength="20" DefaultValue="PENDING"/>
      </EntityType>
      <EntityType Name="WorkflowTask">
        <Key>
          <PropertyRef Name="ID"/>
        </Key>
        <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
        <Property Name="createdAt" Type="Edm.DateTimeOffset" Precision="7"/>
        <Property Name="createdBy" Type="Edm.String" MaxLength="255"/>
        <Property Name="modifiedAt" Type="Edm.DateTimeOffset" Precision="7"/>
        <Property Name="modifiedBy" Type="Edm.String" MaxLength="255"/>
        <Property Name="title" Type="Edm.String" MaxLength="160" Nullable="false"/>
        <NavigationProperty Name="employee" Type="ApprovalService.Employee" Nullable="false">
          <ReferentialConstraint Property="employee_ID" ReferencedProperty="ID"/>
        </NavigationProperty>
        <Property Name="employee_ID" Type="Edm.Guid" Nullable="false"/>
        <NavigationProperty Name="leaveRequest" Type="ApprovalService.LeaveRequest" Nullable="false">
          <ReferentialConstraint Property="leaveRequest_ID" ReferencedProperty="ID"/>
        </NavigationProperty>
        <Property Name="leaveRequest_ID" Type="Edm.Guid" Nullable="false"/>
        <Property Name="status" Type="Edm.String" MaxLength="20" DefaultValue="READY"/>
        <Property Name="completedAt" Type="Edm.DateTimeOffset" Precision="7"/>
        <Property Name="completedBy" Type="Edm.String" MaxLength="120"/>
        <Property Name="decisionComment" Type="Edm.String" MaxLength="1000"/>
        <Property Name="employeeName" Type="Edm.String" MaxLength="120"/>
        <Property Name="department" Type="Edm.String" MaxLength="80"/>
        <Property Name="employeeEmail" Type="Edm.String" MaxLength="120"/>
        <Property Name="leaveType" Type="Edm.String" MaxLength="40"/>
        <Property Name="leaveStartDate" Type="Edm.Date"/>
        <Property Name="leaveEndDate" Type="Edm.Date"/>
        <Property Name="days" Type="Edm.Int32"/>
        <Property Name="reason" Type="Edm.String" MaxLength="500"/>
      </EntityType>
      <EntityType Name="ApprovalHistory">
        <Key>
          <PropertyRef Name="ID"/>
        </Key>
        <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
        <NavigationProperty Name="workflowTask" Type="ApprovalService.WorkflowTask" Nullable="false">
          <ReferentialConstraint Property="workflowTask_ID" ReferencedProperty="ID"/>
        </NavigationProperty>
        <Property Name="workflowTask_ID" Type="Edm.Guid" Nullable="false"/>
        <NavigationProperty Name="leaveRequest" Type="ApprovalService.LeaveRequest" Nullable="false">
          <ReferentialConstraint Property="leaveRequest_ID" ReferencedProperty="ID"/>
        </NavigationProperty>
        <Property Name="leaveRequest_ID" Type="Edm.Guid" Nullable="false"/>
        <Property Name="step" Type="Edm.Int32" Nullable="false"/>
        <Property Name="approverName" Type="Edm.String" MaxLength="120" Nullable="false"/>
        <Property Name="decision" Type="Edm.String" MaxLength="20" Nullable="false"/>
        <Property Name="comment" Type="Edm.String" MaxLength="1000"/>
        <Property Name="createdAt" Type="Edm.DateTimeOffset" Precision="7"/>
      </EntityType>
      <Action Name="approveTask" IsBound="false">
        <Parameter Name="taskId" Type="Edm.Guid"/>
        <Parameter Name="comment" Type="Edm.String"/>
        <ReturnType Type="ApprovalService.WorkflowTask"/>
      </Action>
      <Action Name="rejectTask" IsBound="false">
        <Parameter Name="taskId" Type="Edm.Guid"/>
        <Parameter Name="comment" Type="Edm.String"/>
        <ReturnType Type="ApprovalService.WorkflowTask"/>
      </Action>
      <Annotations Target="ApprovalService.Employee/ID">
        <Annotation Term="Core.ComputedDefaultValue" Bool="true"/>
      </Annotations>
      <Annotations Target="ApprovalService.LeaveRequest/ID">
        <Annotation Term="Core.ComputedDefaultValue" Bool="true"/>
      </Annotations>
      <Annotations Target="ApprovalService.LeaveRequest/createdAt">
        <Annotation Term="UI.HiddenFilter" Bool="true"/>
        <Annotation Term="UI.ExcludeFromNavigationContext" Bool="true"/>
        <Annotation Term="Core.Immutable" Bool="true"/>
        <Annotation Term="Core.Computed" Bool="true"/>
        <Annotation Term="Common.Label" String="{i18n>CreatedAt}"/>
      </Annotations>
      <Annotations Target="ApprovalService.LeaveRequest/createdBy">
        <Annotation Term="UI.HiddenFilter" Bool="true"/>
        <Annotation Term="UI.ExcludeFromNavigationContext" Bool="true"/>
        <Annotation Term="Core.Immutable" Bool="true"/>
        <Annotation Term="Core.Computed" Bool="true"/>
        <Annotation Term="Core.Description" String="{i18n>UserID.Description}"/>
        <Annotation Term="Common.Label" String="{i18n>CreatedBy}"/>
      </Annotations>
      <Annotations Target="ApprovalService.LeaveRequest/modifiedAt">
        <Annotation Term="UI.HiddenFilter" Bool="true"/>
        <Annotation Term="UI.ExcludeFromNavigationContext" Bool="true"/>
        <Annotation Term="Core.Computed" Bool="true"/>
        <Annotation Term="Common.Label" String="{i18n>ChangedAt}"/>
      </Annotations>
      <Annotations Target="ApprovalService.LeaveRequest/modifiedBy">
        <Annotation Term="UI.HiddenFilter" Bool="true"/>
        <Annotation Term="UI.ExcludeFromNavigationContext" Bool="true"/>
        <Annotation Term="Core.Computed" Bool="true"/>
        <Annotation Term="Core.Description" String="{i18n>UserID.Description}"/>
        <Annotation Term="Common.Label" String="{i18n>ChangedBy}"/>
      </Annotations>
      <Annotations Target="ApprovalService.WorkflowTask/ID">
